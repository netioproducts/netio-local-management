{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "eu.netio.localmanagement",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/react-src/build/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "events.*",
    "extensions.*",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "netio-local-management",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/icon.png",
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false,
      "enableInspector": false
    },
    "browser": {
      "nativeBlockList": [
        "filesystem.*"
      ]
    },
    "cloud": {
      "url": "/resources/#cloud",
      "nativeAllowList": [
        "app.*"
      ]
    },
    "chrome": {
      "width": 800,
      "height": 500,
      "args": "--user-agent=\"Neutralinojs chrome mode\"",
      "nativeBlockList": [
        "filesystem.*",
        "os.*"
      ]
    }
  },
  "buildScript": {
    "mac": {
      "architecture": [
        "x64",
        "arm64",
        "universal"
      ],
      "minimumOS": "10.13.0",
      "appName": "netio-local-management",
      "appBundleName": "netio-local-management",
      "appIdentifier": "eu.netio.localmanagement",
      "appIcon": "resources/icons/icon.png"
    },
    "win": {
      "architecture": [
        "x64"
      ],
      "appName": "netio-local-management",
      "appIcon": "resources/icons/icon.png"
    },
    "linux": {
      "architecture": [
        "x64"
      ],
      "appName": "netio-local-management",
      "appIcon": "resources/icons/icon.png",
      "appPath": "/usr/share/netio-local-management",
      "appIconPath": "/usr/share/netio-local-management/icon.png",
      "appIconLocation": "/usr/share/netio-local-management/icon.png"
    }
  },
  "cli": {
    "binaryName": "netio-local-management",
    "extensionsPath": "/extensions/",
    "resourcesPath": "/react-src/build/",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.5.0",
    "frontendLibrary": {
      "patchFile": "react-src/index.html",
      "devUrl": "http://localhost:5177",
      "projectPath": "react-src",
      "initCommand": "bun install",
      "buildCommand": "bun run build",
      "devCommand": "bun run start"
    }
  },
  "extensions": [
    {
      "id": "extNode",
      "commandDarwin": "${NL_PATH}/extensions/be-darwin-arm64",
      "commandWindows": "${NL_PATH}/extensions/be-windows-x64.exe",
      "commandLinux": "${NL_PATH}/extensions/be-linux-x64"
    }
  ]
}