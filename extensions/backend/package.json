{
  "name": "backend",
  "version": "0.1.5",
  "main": "dist/main.js",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "build:linux": "rm -rf ../be-linux-x64 && bun build ./src/main.ts --compile --minify --target=bun-linux-x64 --outfile=../be-linux-x64",
    "build:windows": "rm -rf ../be-windows-x64.exe && bun build ./src/main.ts --compile --minify --target=bun-windows-x64 --outfile=../be-windows-x64.exe",
    "build:darwin-arm64": "rm -rf ../be-darwin-arm64 && bun build ./src/main.ts --compile --minify --target=bun-darwin-arm64 --outfile=../be-darwin-arm64",
    "build:darwin-x64": "rm -rf ../be-darwin-x64 && bun build ./src/main.ts --compile --minify --target=bun-darwin-x64 --outfile=../be-darwin-x64",
    "build": "bun run build:linux && bun run build:windows && bun run build:darwin-arm64 && bun run build:darwin-x64"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.2.0",
    "@types/ws": "^8.18.1",
    "bun": "^1.3.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  }
}
